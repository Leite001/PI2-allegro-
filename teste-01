
#include<stdio.h>
#include<allegro5/allegro.h>
#include<allegro5/allegro_primitives.h>
#include<stdbool.h>
#include<allegro5/keyboard.h>
#include<allegro5/mouse.h>
#include<allegro5/timer.h>

void movimentacao(float* xi, float* xf, int largura_tela, float* yi, float* yf, float* velocidadePulo, bool* noChao, bool* virou) {
	
	al_install_keyboard();
	ALLEGRO_KEYBOARD_STATE teclado;
	al_get_keyboard_state(&teclado);
	
		//variaveis
		float velocidade = 0.03f;
		float gravidade = 0.015f;
		//
	
	// Movimentação para a esquerda
	if (al_key_down(&teclado, ALLEGRO_KEY_LEFT)) {
		*xi -= velocidade;
		*xf -= velocidade;
		*virou = true;
	}

	// Movimentação para a direita
	if (al_key_down(&teclado, ALLEGRO_KEY_RIGHT)) {
		*xi += velocidade;
		*xf += velocidade;
		*virou = false;
	}
	// Impede que o personagem saia da tela
	if (*xi < 0) {
		*xi = 0;
		*xf = 50;
	}

	if (*xf > largura_tela) {
		*xf = largura_tela;
		*xi = largura_tela - 50;
	}
	
	// Pulo
	if (al_key_down(&teclado, ALLEGRO_KEY_W) && *noChao == true) {
		*velocidadePulo = -1.8f;
		*noChao = false;
	}
	
	*velocidadePulo += gravidade;
	//gravidade
	*yi += *velocidadePulo;
	*yf += *velocidadePulo;
	
	// Colisão com o chão
	if (*yf >= 400) {
		*yf = 400;
		*yi = *yf - 80;
		*velocidadePulo = 0.0f;
		*noChao = true;
	}
}

void  projetil(float *balaX, float *balaY, bool *balaAtiva,float xi ,float xf, float yi, float yf, int largura_tela, bool *mouseAnterior, bool *virou) {
	
	al_install_mouse();
	ALLEGRO_MOUSE_STATE mouse;
	al_get_mouse_state(&mouse);

	bool mouseAtual = al_mouse_button_down(&mouse, ALLEGRO_MOUSE_BUTTON_LEFT);
	
	float velobala = 0.05f;

	// Detecta um novo clique
	if (mouseAtual && !*mouseAnterior && !*balaAtiva) {
		*balaX = xf;
		*balaY = yi + (yf - yi) / 2;
		*balaAtiva = true;
	}

	*mouseAnterior = mouseAtual;

	if (*balaAtiva && *virou == false) {
		*balaX += velobala;

		al_draw_filled_rectangle(
			*balaX, *balaY - 5,
			*balaX + 20, *balaY + 5,
			al_map_rgb(0, 255, 0)
		);//projetil desenhado direita
	}	
	else
	{
		if (*balaAtiva && *virou == true) {
			*balaX -= velobala;
			al_draw_filled_rectangle(
				*balaX, *balaY - 5,
				*balaX - 20, *balaY + 5,
				al_map_rgb(0, 255, 0)
			);//projetil desenhado esquerda
		}
	}

		// Desativa a bala quando sair da tela
		if (*balaX > largura_tela) {
			*balaAtiva = false;
		}
		else {
			if (*balaX < 0) {
				*balaAtiva = false;
			}
		}
}

typedef struct {
	float x;
	float y;
	float raio;
	float velocidade;
	bool ativo;
	int dano;
	int vida;
}inimigo;


int main() {
	//inicializando allegro
	al_init();
	al_init_primitives_addon();
	al_install_keyboard();
	al_install_mouse();
	//

	//display dimensões (tela)
	int altura_tela = 500;
	int largura_tela = 860;
	ALLEGRO_DISPLAY* display = al_create_display(largura_tela, altura_tela);
	al_set_window_position(display, 200, 200);
	//
		
		//variaveis	
		float xi = 400.0f;
		float xf = 450.0f;
		float yi = 320.0f;
		float yf = 400.0f;
		float velocidade = 0.03f;
		float balaX = 0.0f;
		float balaY = 0.0f;
		float velocidadePulo = 0.0f;
		bool noChao = true;
		bool virou = false;
		bool balaAtiva = false;
		ALLEGRO_KEYBOARD_STATE teclado;
		ALLEGRO_MOUSE_STATE mouse;
		bool mouseAnterior = false;
		//struct inimigo
		inimigo azul = { -30, 370,30,0.02f, 5, 3};
		inimigo branco = { -40, 370,30,0.02f, 5, 3};
		inimigo amarelo = { -50, 370,30,0.02f, 5, 3};
		//
	
	//jogo rodando
	while (true) {
		al_get_keyboard_state(&teclado);
		al_get_mouse_state(&mouse);
		
		//chamando a função
		movimentacao(&xi, &xf, largura_tela, &yi, &yf, &velocidadePulo, &noChao, &virou);

		al_clear_to_color(al_map_rgb(194, 191, 29));

		al_draw_filled_rectangle(xi, yi, xf, yf, al_map_rgb(255, 0, 0));//personagem
		//função projetil float *balaX, float *balaY, bool *balaAtiva, float xf, float yi, float yf, int largura_tela, bool *mouseAnterior, bool *mouseAtual
		projetil(&balaX, &balaY, &balaAtiva, xi, xf, yi, yf, largura_tela, &mouseAnterior, &virou);
		
		al_draw_filled_circle(azul.x, azul.y, azul.raio	, al_map_rgb(0, 0, 255));

		al_draw_filled_rectangle(0, 400, largura_tela, altura_tela, al_map_rgb(0, 0, 0));//chao
		al_flip_display();
	}

	al_uninstall_keyboard();
	al_uninstall_mouse();
	al_destroy_display(display);

	return 0;
}
